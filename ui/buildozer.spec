[app]

# ============================================================
# اطلاعات برنامه
# ============================================================

title = خریدیار
package.name = kharidyar
package.domain = org.kharidyar

source.dir = .
source.include_exts = py,png,jpg,jpeg,ttf,atlas,kv

version = 1.0.0

orientation = portrait


# ============================================================
# وابستگی‌های Python
# ============================================================

requirements = python3,kivy==2.3.1


# ============================================================
# تنظیمات Android
# ============================================================

android.api = 35
android.minapi = 24

android.ndk = 27c
android.ndk_api = 24

android.archs = arm64-v8a

android.accept_sdk_license = True
android.enable_androidx = True


# ============================================================
# دسترسی‌های Android
# ============================================================

android.permissions = INTERNET


# ============================================================
# آیکون برنامه
# ============================================================

# این فایل بعداً در Repository قرار می‌گیرد:
# assets/icon.png

icon.filename = %(source.dir)s/assets/icon.png


# ============================================================
# تنظیمات Build
# ============================================================

log_level = 2

warn_on_root = 1

p4a.branch = master


# ============================================================
# تنظیمات عمومی
# ============================================================

fullscreen = 0


# ============================================================
# Include / Exclude
# ============================================================

source.exclude_dirs = .git,.github,__pycache__,.buildozer


[buildozer]

# سطح نمایش لاگ
log_level = 2

# هشدار در صورت اجرای Build با root
warn_on_root = 1
